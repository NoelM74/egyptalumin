---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Industries Served | Custom Aluminium Casting & Extrusion Feedstock" 
  description="Tech Aluminum supplies high-purity A7 ingots, ADC12, and AL-Si alloys to primary European B2B industries, including Automotive, Aerospace, Construction, and Electrical Grid infrastructure."
  lang="en"
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/en/">Home</a></li>
        <li aria-current="page">Industries</li>
      </ol>
    </div>
  </nav>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="product-hero">
    <div class="container">
      <div style="text-align: center; max-width: 850px; margin: 0 auto;">
        <span class="eyebrow on-dark">Premium Feedstock for Global B2B Brands</span>
        <h1 style="font-size: 3.2rem; margin-bottom: 1.2rem;">Industries We Supply</h1>
        <p class="product-hero-lead" style="font-size: 1.25rem;">
          Providing certified chemical purity, reliable delivery schedules, and fully registered REACH/CBAM compliance 
          across Europe's highest-value manufacturing sectors.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       INDUSTRIES GRID
       ============================================================ -->
  <section style="background: var(--white); padding: 5rem 0;">
    <div class="container">
      <div class="product-grid" style="grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem;">

        <!-- Automotive · ADC12 -->
        <a href="/en/industries/automotive/" class="industry-card">
          <div class="industry-card-img">
            <img src="/images/applications/4.2-aluminium-automotive-components-engine-parts-wheel-hub.webp" alt="Automotive and EV components" />
            <span class="product-avail available">ADC12 available now</span>
          </div>
          <div class="industry-card-body">
            <h3>Automotive &amp; EV Die Casting</h3>
            <p>Transmission and gearbox housings, motor and inverter housings, oil pans and EV battery trays. AL-Si where the part carries structural load.</p>
            <span class="industry-card-alloy">Primary alloy: ADC12 <span class="industry-card-arrow">→</span></span>
          </div>
        </a>

        <!-- Mechanical manufacturing · ADC12 -->
        <a href="/en/industries/mechanical-manufacturing/" class="industry-card">
          <div class="industry-card-img">
            <img src="/images/applications/4.8-aluminium-cnc-machined-parts-industrial-manufacturing.webp" alt="Industrial machined aluminium components" />
            <span class="product-avail available">ADC12 available now</span>
          </div>
          <div class="industry-card-body">
            <h3>Heavy Industrial Machinery</h3>
            <p>Motor housings, hydraulic pump brackets, pneumatic valve bodies and robotic joint components. Pressure-tight castings at production volume.</p>
            <span class="industry-card-alloy">Primary alloy: ADC12 <span class="industry-card-arrow">→</span></span>
          </div>
        </a>

        <!-- Electronics · ADC12 -->
        <a href="/en/industries/electronics/" class="industry-card">
          <div class="industry-card-img">
            <img src="/images/applications/4.5-aluminium-heat-sink-electronic-components-manufacturing.webp" alt="Aluminium heat sinks and electronic components" />
            <span class="product-avail available">ADC12 available now</span>
          </div>
          <div class="industry-card-body">
            <h3>Electronics &amp; Thermal Management</h3>
            <p>Device housings, LED driver enclosures, 5G base station casings and cast heat sinks. Thin-wall capability down to 1.2 mm.</p>
            <span class="industry-card-alloy">Primary alloy: ADC12 <span class="industry-card-arrow">→</span></span>
          </div>
        </a>

        <!-- Construction · A7 -->
        <a href="/en/industries/construction/" class="industry-card">
          <div class="industry-card-img">
            <img src="/images/applications/4.4-aluminium-curtain-wall-facade-modern-building-construction.webp" alt="Aluminium curtain wall and facade construction" />
            <span class="product-avail allocated">A7 allocated</span>
          </div>
          <div class="industry-card-body">
            <h3>Building, Architecture &amp; Extrusions</h3>
            <p>A7 charge material for 6xxx-series extrusion billet, window frames and curtain walls. Architectural hardware and facade brackets cast in ADC12.</p>
            <span class="industry-card-alloy">Primary alloy: A7 (99.7%) <span class="industry-card-arrow">→</span></span>
          </div>
        </a>

        <!-- Aerospace · A7 -->
        <a href="/en/industries/aerospace/" class="industry-card">
          <div class="industry-card-img">
            <img src="/images/applications/4.3-aluminium-aerospace-aircraft-fuselage-structural-components.webp" alt="Aerospace aluminium structural components" />
            <span class="product-avail allocated">A7 allocated</span>
          </div>
          <div class="industry-card-body">
            <h3>Aerospace &amp; Precision Forgings</h3>
            <p>Primary metal with tightly controlled residuals for forging and plate stock, plus AlSi7Mg for precision castings.</p>
            <span class="industry-card-alloy">Primary alloy: A7 (99.7%) <span class="industry-card-arrow">→</span></span>
          </div>
        </a>

        <!-- Power &amp; transportation · A7 -->
        <a href="/en/industries/power-transportation/" class="industry-card">
          <div class="industry-card-img">
            <img src="/images/applications/4.7-aluminium-power-cable-conductors-rail-transit-components.webp" alt="Aluminium power conductors and rail transit components" />
            <span class="product-avail allocated">A7 allocated</span>
          </div>
          <div class="industry-card-body">
            <h3>Electrical Grid &amp; Power Transmission</h3>
            <p>High-conductivity A7 for wire rod, overhead cable and busbar. Rail transit housings and enclosures cast in ADC12.</p>
            <span class="industry-card-alloy">Primary alloy: A7 (99.7%) <span class="industry-card-arrow">→</span></span>
          </div>
        </a>

        <!-- Packaging · A7 -->
        <a href="/en/industries/packaging/" class="industry-card">
          <div class="industry-card-img">
            <img src="/images/applications/4.6-aluminium-packaging-cans-foil-beverage-food-industry.webp" alt="Aluminium packaging, cans and foil" />
            <span class="product-avail allocated">A7 allocated</span>
          </div>
          <div class="industry-card-body">
            <h3>Food &amp; Pharmaceutical Packaging</h3>
            <p>Rolling slab from primary melts for preservation foil, deep-drawn beverage cans and sterile medical packaging.</p>
            <span class="industry-card-alloy">Primary alloy: A7 (99.7%) <span class="industry-card-arrow">→</span></span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ============================================================
       FINAL CTA
       ============================================================ -->
  <section class="final-cta">
    <div class="container">
      <span class="eyebrow on-dark">Direct B2B Procurement</span>
      <h2>Secure your feedstock supply allocation</h2>
      <p>Whether you require narrowed composition windows, custom heat bundle counts, or trial shipment allocations, speak directly with Noel Murphy.</p>
      <div class="final-cta-actions">
        <a href="/en/contact/" class="btn btn-primary">Request a Quote</a>
        <a href="https://wa.me/353871187806" class="btn btn-secondary">Message Noel on WhatsApp</a>
      </div>
      <p class="final-cta-direct">
        Direct Email: <a href="mailto:noel@techaluminum.com">noel@techaluminum.com</a> · WhatsApp: <a href="https://wa.me/353871187806">Direct Chat</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .product-img-modern:hover {
    transform: scale(1.03);
  }
</style>
