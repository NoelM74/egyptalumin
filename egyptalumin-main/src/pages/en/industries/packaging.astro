---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Aluminium Ingots for Packaging & Food Applications | Tech Aluminum" lang="en">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container"><ol>
      <li><a href="/en/">Home</a></li>
      <li><a href="/en/industries/">Industries</a></li>
      <li aria-current="page">Packaging</li>
    </ol></div>
  </nav>

  <section class="product-hero">
    <div class="container">
      <div class="product-hero-grid" style="grid-template-columns:1fr;">
        <div style="max-width:800px;">
          <span class="eyebrow on-dark">Industry Application</span>
          <h1>Aluminium for Packaging & Food-Grade Applications</h1>
          <p class="product-hero-lead">High-purity primary ingots for foil, can stock and food-grade packaging. REACH-compliant with full material safety documentation.</p>
          <div class="product-hero-ctas">
            <a href="/en/contact/" class="btn btn-primary">Request Specifications</a>
            <a href="/en/products/" class="btn btn-secondary">View All Products</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="padding:5rem 0;background:var(--warm-white);">
    <div class="container" style="max-width:820px;">
      <h2>Products for packaging applications</h2>
      <p>Aluminium packaging — beverage cans, pharmaceutical foil, food-contact closures — demands the highest purity feedstock to meet food safety regulations and achieve the mechanical properties required for rolling and deep drawing.</p>
      <ul>
        <li><strong>A7 Primary Aluminium Ingot (EN 576, P1020A)</strong> — 99.7% minimum purity. The standard charge material for foil-grade and can-body sheet production. Full REACH compliance documentation and material safety data sheets provided.</li>
      </ul>
      <p>All shipments to EU buyers include CBAM embedded-emissions data as required under EU regulations effective January 2026.</p>
      <a href="/en/contact/" class="btn btn-primary" style="margin-top:1.5rem;display:inline-flex;">Request specifications →</a>
    </div>
  </section>

  <section style="padding:0 0 4.5rem 0;">
    <div class="container" style="max-width:900px;">
      <div class="allocation-notice">
        <div class="allocation-notice-main">
          <span class="eyebrow" style="color:var(--gold);">Supply status</span>
          <h2 style="font-size:1.4rem;margin:0.4rem 0 0.75rem 0;font-family:'Plus Jakarta Sans',sans-serif;color:var(--navy);">A7 primary ingot is fully allocated</h2>
          <p style="margin:0 0 0.8rem 0;color:var(--ink-soft);font-size:0.95rem;">
            Rolling slab for foil and can stock has to start from primary metal. No casting alloy
            substitutes for it, and we will not suggest one. Our current A7 output is committed to
            existing contracts through to Q2 2027.
          </p>
          <p style="margin:0;color:var(--ink-soft);font-size:0.95rem;">
            We are taking reservations against that window now, and Noel will tell you where you sit in
            the queue before you commit to anything. If your delivery schedule is fixed,
            say so on the enquiry and we will be straight with you about whether we can meet it.
          </p>
        </div>
        <div class="allocation-notice-cta">
          <a href="/en/contact/?product=A7" class="btn btn-primary" style="width:100%;justify-content:center;text-align:center;">Reserve A7 allocation</a>
          <a href="/en/products/a7-primary-aluminium-ingot/" class="btn btn-ghost" style="width:100%;justify-content:center;text-align:center;">A7 specifications</a>
        </div>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <h2>Sourcing primary aluminium for packaging production?</h2>
      <p>Noel Murphy handles all European enquiries. Response within 24 hours.</p>
      <div class="final-cta-actions">
        <a href="/en/contact/" class="btn btn-primary">Request a Quote</a>
        <a href="https://wa.me/353871187806" class="btn btn-secondary">WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>
