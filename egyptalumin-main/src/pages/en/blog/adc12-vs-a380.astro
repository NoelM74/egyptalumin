      "datePublished": "2026-09-03T08:00:00+02:00",
      "dateModified": "2026-09-03T08:00:00+02:00",
      "author": {
        "@type": "Person", "name": "Noel Murphy", "jobTitle": "Partner, European Operations",
        "worksFor": { "@type": "Organization", "name": "Tech Aluminum" }
