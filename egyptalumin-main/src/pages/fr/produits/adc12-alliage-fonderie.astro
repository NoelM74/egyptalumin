                <tr><td>Plomb (Pb)</td><td class="num">—</td><td class="num">0,2</td></tr>
                <tr><td>Titane (Ti)</td><td class="num">—</td><td class="num">0,2</td></tr>
                <tr><td>Aluminium (Al)</td><td class="num" colspan="2">Reste</td></tr>
