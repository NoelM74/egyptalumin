---
import Layout from '../../layouts/Layout.astro';

const WEB3FORMS_KEY = '2b6f383a-1087-4cde-8534-d0628fcc305b';
const RFQ_TO = 'contact@techaluminum.com';
---

<Layout
  title="Contatta il nostro ufficio commerciale e tecnico | Tech Aluminum"
  description="Richiedi un preventivo o un campione dei nostri lingotti ADC12, AL-Si o alluminio primario A7. Risposta diretta da Noel Murphy entro 24 ore."
  lang="it"
>
  <nav class="breadcrumb" aria-label="Percorso di navigazione">
    <div class="container">
      <ol>
        <li><a href="/it/">Home</a></li>
        <li aria-current="page">Contatti</li>
      </ol>
    </div>
  </nav>

  <section class="product-hero" style="padding: 4rem 0 3rem 0;">
    <div class="container">
      <div style="text-align: center; max-width: 800px; margin: 0 auto;">
        <span class="eyebrow on-dark">Risposta B2B entro 24 ore</span>
        <h1 style="font-size: 3rem; margin-bottom: 1rem;">Ufficio commerciale e tecnico</h1>
        <p class="product-hero-lead" style="font-size: 1.15rem; color: rgba(255,255,255,0.85);">
          Richiedete listini, finestre di composizione più strette o una fornitura di prova
          per le vostre colate di qualifica direttamente a Noel Murphy.
        </p>
      </div>
    </div>
  </section>

  <section style="background: var(--white); padding: 5rem 0;">
    <div class="container">
      <div class="cbam-inner" style="grid-template-columns: 1.2fr 0.8fr; gap: 4rem; align-items: start;">

        <div style="background: var(--silver-soft); border: 1px solid var(--border); padding: clamp(1.25rem, 5vw, 3rem); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
          <h2 style="font-size: 1.8rem; margin-bottom: 0.5rem; font-family:'Plus Jakarta Sans',sans-serif;">Richiesta di offerta (RFQ)</h2>
          <p style="color:var(--ink-soft); font-size:0.95rem; margin-bottom: 1.25rem;">Compilate il modulo qui sotto. Noel Murphy o il nostro ufficio tecnico vi risponderà entro un giorno lavorativo.</p>

          <div id="rfq-product-note" hidden style="display:flex; align-items:center; gap:0.6rem; background:rgba(0,105,77,0.08); border-left:3px solid var(--teal); border-radius:6px; padding:0.8rem 1rem; margin-bottom:1.5rem; font-size:0.9rem; font-weight:600; color:var(--navy);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0; color:var(--teal);"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span id="rfq-product-note-text"></span>
          </div>

          <form id="rfq-form" class="contact-form" style="display:flex; flex-direction:column; gap:1.5rem;">
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Nuova RFQ — Sito Tech Aluminum (IT)" />
            <input type="hidden" name="from_name" value="Tech Aluminum Website" />
            <input type="hidden" name="Origine richiesta" id="rfq-source" value="Diretta" />
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

            <div class="form-row">
              <div>
                <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:0.5rem; color:var(--navy);">Nome e cognome *</label>
                <input type="text" name="Nome" required placeholder="Mario Rossi" style="width:100%; padding:0.75rem; border:1px solid var(--border); border-radius:6px; font-family:inherit;" />
              </div>
              <div>
                <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:0.5rem; color:var(--navy);">Azienda *</label>
                <input type="text" name="Azienda" required placeholder="Fonderia S.p.A." style="width:100%; padding:0.75rem; border:1px solid var(--border); border-radius:6px; font-family:inherit;" />
              </div>
            </div>

            <div class="form-row">
              <div>
                <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:0.5rem; color:var(--navy);">E-mail aziendale *</label>
                <input type="email" name="E-mail" required placeholder="mario@azienda.it" style="width:100%; padding:0.75rem; border:1px solid var(--border); border-radius:6px; font-family:inherit;" />
              </div>
              <div>
                <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:0.5rem; color:var(--navy);">WhatsApp / Telefono</label>
                <input type="text" name="WhatsApp o Telefono" placeholder="+39 340 1234567" style="width:100%; padding:0.75rem; border:1px solid var(--border); border-radius:6px; font-family:inherit;" />
              </div>
            </div>

            <div class="form-row">
              <div>
                <label for="product-interest" style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:0.5rem; color:var(--navy);">Prodotto di interesse</label>
                <select id="product-interest" name="Prodotto" style="width:100%; padding:0.75rem; border:1px solid var(--border); border-radius:6px; font-family:inherit; background:white;">
                  <option data-product="ADC12">Lega da fonderia (ADC12 / EN AC-46000)</option>
                  <option data-product="AL-Si">Lega alluminio-silicio (AlSi7Mg / AlSi11 / Altro)</option>
                  <option data-product="A7">Lingotto primario (A7 / Al99,7)</option>
                  <option data-product="Other">Altra specifica / colata su misura</option>
                </select>
              </div>
              <div>
                <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:0.5rem; color:var(--navy);">Fabbisogno mensile stimato (tonnellate)</label>
                <input type="text" name="Fabbisogno mensile" placeholder="es. 50 tonnellate" style="width:100%; padding:0.75rem; border:1px solid var(--border); border-radius:6px; font-family:inherit;" />
              </div>
            </div>

            <div>
              <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:0.5rem; color:var(--navy);">Requisiti specifici / messaggio</label>
              <textarea name="Messaggio" placeholder="Descrivete tolleranze di composizione, configurazione dei pacchi o esigenze per una fornitura di prova..." style="width:100%; padding:0.75rem; border:1px solid var(--border); border-radius:6px; font-family:inherit; min-height:120px; resize:vertical;"></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width:fit-content; cursor:pointer; font-size:1rem; padding: 0.85rem 2rem;">Invia richiesta</button>
            <div id="rfq-status" role="status" aria-live="polite" style="font-size:0.9rem; font-weight:600;"></div>
          </form>
        </div>

        <div style="display:flex; flex-direction:column; gap:2rem;">
          <div style="background:var(--silver-soft); border:1px solid var(--border); padding:2rem; border-radius:var(--radius-lg); text-align:center;">
            <div style="width:110px; height:110px; border-radius:50%; overflow:hidden; margin:0 auto 1.25rem auto; box-shadow:var(--shadow-md);">
              <img src="/images/branding/brand-noel-murphy-portrait-01.webp" alt="Noel Murphy" style="width:100%; height:100%; object-fit:cover;" />
            </div>
            <h3 style="font-family:'Plus Jakarta Sans',sans-serif; margin-bottom:0.25rem;">Noel Murphy</h3>
            <span style="color:var(--teal); font-weight:600; font-size:0.85rem; text-transform:uppercase; display:block; margin-bottom:1rem;">Referente commerciale Europa</span>
            <hr style="border:0; border-top:1px solid var(--border); margin-bottom:1.25rem;" />
            <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.75rem; font-size:0.9rem; text-align:left;">
              <li style="display:flex; gap:0.5rem;">
                <span>✉️</span>
                <a href="mailto:noel@techaluminum.com" style="color:var(--navy); font-weight:600;">noel@techaluminum.com</a>
              </li>
              <li style="display:flex; gap:0.5rem;">
                <span>💬</span>
                <a href="https://wa.me/353871187806" target="_blank" style="color:var(--teal); font-weight:600;">Chat diretta su WhatsApp</a>
              </li>
            </ul>
          </div>

          <div style="background:var(--navy); color:white; padding:2rem; border-radius:var(--radius-lg);">
            <h3 style="font-family:'Plus Jakarta Sans',sans-serif; margin-bottom:1rem; font-size:1.15rem; color:var(--gold-light);">Conformità documentale:</h3>
            <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.8rem; font-size:0.85rem; color:rgba(255,255,255,0.85);">
              <li>✓ Numero di registrazione REACH disponibile</li>
              <li>✓ Dati CBAM trimestrali verificati</li>
              <li>✓ Produzione certificata ISO 9001:2015</li>
              <li>✓ Certificati di collaudo EN 10204 3.1</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <script define:vars={{ RFQ_TO }}>
    const form = document.getElementById('rfq-form');
    const statusEl = document.getElementById('rfq-status');

    const params = new URLSearchParams(window.location.search);
    const requested = params.get('product');
    const select = document.getElementById('product-interest');
    const note = document.getElementById('rfq-product-note');
    const noteText = document.getElementById('rfq-product-note-text');
    if (requested && select) {
      const match = Array.from(select.options).find(
        (o) => (o.dataset.product || '').toLowerCase() === requested.trim().toLowerCase()
      );
      if (match) {
        select.value = match.value;
        noteText.textContent = 'Richiesta per: ' + match.textContent.trim();
        note.hidden = false;
      }
    }

    const sourceEl = document.getElementById('rfq-source');
    if (sourceEl) {
      const parts = [];
      if (requested) parts.push('product=' + requested);
      parts.push(document.referrer ? 'da ' + document.referrer : 'nessun referrer');
      sourceEl.value = parts.join(' · ');
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        if (data.get('botcheck')) return;
        const key = data.get('access_key');
        statusEl.style.color = 'var(--ink-soft)';
        statusEl.textContent = 'Invio in corso…';
        if (key && key !== '2b6f383a-1087-4cde-8534-d0628fcc305b') {
          try {
            const res = await fetch('https://api.web3forms.com/submit', {
              method: 'POST', headers: { Accept: 'application/json' }, body: data
            });
            const out = await res.json();
            if (out.success) {
              form.reset();
              statusEl.style.color = 'var(--teal)';
              statusEl.textContent = 'Grazie, la vostra richiesta è stata inviata. Noel risponderà entro un giorno lavorativo.';
              return;
            }
          } catch (err) { /* fallback mailto */ }
        }
        const skip = ['access_key', 'subject', 'from_name', 'botcheck'];
        const lines = [];
        for (const [k, v] of data.entries()) { if (!skip.includes(k) && v) lines.push(k + ': ' + v); }
        window.location.href = 'mailto:' + RFQ_TO + '?subject=' + encodeURIComponent('Nuova RFQ — Sito Tech Aluminum (IT)') + '&body=' + encodeURIComponent(lines.join('\n'));
        statusEl.style.color = 'var(--ink-soft)';
        statusEl.textContent = 'Apertura del vostro client di posta per inviare la richiesta a ' + RFQ_TO + '…';
      });
    }
  </script>
</Layout>
